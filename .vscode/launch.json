{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [
                "0",
                "0",
                "0",
                "0",
                "/home/nikita_viksne/Документы/C_Cpp_progs/InertialNavigation/Data_files/data_acc_veloc_0_heading_0_eqautor_grinvich_freq_400_gps.csv",
                "1",
                "1",
                "0",
                "0",
                "0"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "PATH",
                    "value": "${env:PATH}:${command:cmake.getLaunchTargetDirectory}"
